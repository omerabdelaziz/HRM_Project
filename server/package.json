{
  "name": "@hrms/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --no-experimental-require-module src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --no-experimental-require-module prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "openapi": "tsx --no-experimental-require-module src/scripts/export-openapi.ts",
    "backup": "tsx --no-experimental-require-module src/scripts/backup.ts"
  },
  "prisma": {
    "seed": "tsx --no-experimental-require-module prisma/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "exceljs": "4.4.0",
    "express": "4.22.3",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "libphonenumber-js": "^1.12.25",
    "multer": "1.4.5-lts.1",
    "node-cron": "3.0.3",
    "nodemailer": "10.1.6",
    "otplib": "12.0.1",
    "pdfkit": "0.15.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "qrcode": "1.5.4",
    "swagger-ui-express": "5.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.1",
    "@types/node-cron": "3.0.11",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.13.5",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "4.1.7",
    "esbuild": "0.24.0",
    "pino-pretty": "13.0.0",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "4.1.12"
  }
}
