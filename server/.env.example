# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hrms
# Used by the test suite (it is wiped and recreated on every run)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hrms_test
CLIENT_ORIGIN=http://localhost:5310
# 48+ random characters
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# 32 random bytes, base64 – encrypts bank details, national IDs and MFA secrets
DATA_ENCRYPTION_KEY=
# 32 random bytes, base64 – keyed hash for duplicate detection of national IDs
DATA_HASH_KEY=
STORAGE_DIR=./storage
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
AUDIT_RETENTION_DAYS=2555
# Email. Leave SMTP_HOST empty to log emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Aziz HRM <no-reply@example.com>"
# Run cron jobs (reminders, escalations, backups) in this process
ENABLE_SCHEDULER=true
PG_BIN_DIR=
# trace | debug | info | warn | error
LOG_LEVEL=info
